# .env.example

# Telegram Bot
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
BOT_USERNAME=your_bot_username

# FastAPI / Backend
# Lokal: http://localhost:3000
# VPS + Cloudflare quick tunnel: tunnel log'dagi manzil, masalan:
# WEBAPP_URL=https://xxx.trycloudflare.com
WEBAPP_URL=http://localhost:3000
ADMIN_ID=123456789

# Obuna sharti bo'lgan kanal (bot kanalda ADMIN bo'lishi shart!)
CHANNEL_URL=https://t.me/gamespotofficial
# Ixtiyoriy: privat kanal bo'lsa raqamli ID (-100...). Bo'sh bo'lsa CHANNEL_URL ishlatiladi
# CHANNEL_ID=-1001234567890

# Database (PostgreSQL)
# For local Docker compose use the service name "db"
DATABASE_URL=postgresql+asyncpg://gamespot:secret@db:5432/gamespot

# Optional SQLite fallback (uncomment if you prefer SQLite)
# DATABASE_URL=sqlite+aiosqlite:///./sqlite.db
